{
  "_note": "Rename this file to sharepoint-list-schema-config.json and replace all placeholder values before running either script.",
  "SourceSiteUrl": "https://<tenant>.sharepoint.com/sites/<source-site>",
  "TargetSiteUrl": "https://<tenant>.sharepoint.com/sites/<target-site>",
  "ExcludedListUrls": [
    "/sites/<source-site>/Lists/<list-name>"
  ],
  "IncludedDocumentLibraryTitles": [
    "<document-library-title>"
  ]
}