{
  "properties": {
    "connectionReferences": {
      "shared_keyvault": {
        "api": {
          "name": "shared_keyvault"
        },
        "connection": {
          "connectionReferenceLogicalName": "clr_UPMDHAAzureVaultConnection"
        },
        "runtimeSource": "embedded"
      },
      "shared_sharepointonline": {
        "api": {
          "name": "shared_sharepointonline"
        },
        "connection": {
          "connectionReferenceLogicalName": "clr_UPMDHASharePointConnection"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)": {
          "defaultValue": "https://upsidecapitalholdings.sharepoint.com/Automation/UPM-DHA/DEV",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointSite"
          }
        },
        "UPM-DHA ResMan API (Secret Name) (clr_UPMDHAResManAPISecretName)": {
          "defaultValue": "ResMan-Authorization-PRD",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHAResManAPISecretName"
          }
        },
        "UPM-DHA SharePoint List (Properties) (clr_UPMDHASharePointListProperties)": {
          "defaultValue": "7032a819-56eb-48db-8468-e4e41f124840",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointListProperties"
          }
        },
        "UPM-DHA SharePoint List (Intake Form) (clr_UPMDHASharePointListIntakeForm)": {
          "defaultValue": "26ac3f0d-5a5d-47cd-a6b8-1e99b9d34b87",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointListIntakeForm"
          }
        },
        "UPM-DHA ResMan API (Account ID) (clr_UPMDHAResManAPIAccountID)": {
          "defaultValue": "2012",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHAResManAPIAccountID"
          }
        },
        "UPM-DHA ResMan API (Base URL) (clr_UPMDHAResManAPIBaseURL)": {
          "defaultValue": "https://partners-api.myresman.com",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHAResManAPIBaseURL"
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {},
              "required": []
            }
          }
        }
      },
      "actions": {
        "Get_Receivables": {
          "type": "Scope",
          "actions": {
            "Get_ResMan_Secret": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "secretName": "@parameters('UPM-DHA ResMan API (Secret Name) (clr_UPMDHAResManAPISecretName)')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
                  "operationId": "GetSecret",
                  "connectionName": "shared_keyvault"
                }
              }
            },
            "Get_SPL_Properties": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')",
                  "table": "@parameters('UPM-DHA SharePoint List (Properties) (clr_UPMDHASharePointListProperties)')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline"
                }
              },
              "runAfter": {
                "Get_ResMan_Secret": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 5000
                }
              }
            },
            "Each_Property": {
              "type": "Foreach",
              "foreach": "@outputs('Get_SPL_Properties')?['body/value']",
              "actions": {
                "Get_Receivebles": {
                  "type": "Http",
                  "inputs": {
                    "uri": "@{parameters('UPM-DHA ResMan API (Base URL) (clr_UPMDHAResManAPIBaseURL)')}/Transactions/Receivables?propertyId=@{item()?['propertyId']}&date=@{formatDateTime(\n  utcNow(),\n  'yyyy-MM-dd'\n)}",
                    "method": "GET",
                    "headers": {
                      "ResMan-Account-Id": "@{parameters('UPM-DHA ResMan API (Account ID) (clr_UPMDHAResManAPIAccountID)')}",
                      "Accept": "application/json",
                      "Content-Type": "application/json",
                      "Authorization": "Basic @{outputs('Get_ResMan_Secret')?['body/value']}"
                    },
                    "retryPolicy": {
                      "type": "fixed",
                      "count": 3,
                      "interval": "PT20S"
                    }
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": {
                      "transferMode": "Chunked"
                    }
                  }
                }
              },
              "runAfter": {
                "Get_SPL_Properties": [
                  "Succeeded"
                ]
              }
            },
            "RSM_Receivables_Obj": {
              "type": "Compose",
              "inputs": "@union(\n  coalesce(\n    body('Get_Receivebles')?[0]?['accounts'], \n    json('[]')\n  ),\n  coalesce(\n    body('Get_Receivebles')?[1]?['accounts'], \n    json('[]')\n  ),\n  coalesce(\n    body('Get_Receivebles')?[2]?['accounts'], \n    json('[]')\n  ),\n  coalesce(\n    body('Get_Receivebles')?[3]?['accounts'], \n    json('[]')\n  ),\n  coalesce(\n    body('Get_Receivebles')?[4]?['accounts'], \n    json('[]')\n  )\n)",
              "runAfter": {
                "Each_Property": [
                  "Succeeded"
                ]
              }
            },
            "RSM_Receivables_Ary": {
              "type": "Select",
              "inputs": {
                "from": "@outputs('RSM_Receivables_Obj')",
                "select": {
                  "Charges": "@item()?['charges']",
                  "Payments": "@item()?['payments']",
                  "Credits": "@item()?['credits']",
                  "Balance": "@item()?['balance']",
                  "Transactions": "@item()",
                  "billingAccountId": "@item()?['billingAccountId']"
                }
              },
              "runAfter": {
                "RSM_Receivables_Obj": [
                  "Succeeded"
                ]
              }
            },
            "RSM_Receivables_Ids": {
              "type": "Select",
              "inputs": {
                "from": "@body('RSM_Receivables_Ary')",
                "select": "@item()?['billingAccountId']"
              },
              "runAfter": {
                "RSM_Receivables_Ary": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Add_Receivables": {
          "type": "Scope",
          "actions": {
            "Get_SPL_Residents": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')",
                  "table": "@parameters('UPM-DHA SharePoint List (Intake Form) (clr_UPMDHASharePointListIntakeForm)')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline"
                }
              },
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 5000
                }
              },
              "metadata": {
                "operationMetadataId": "23fbea8f-4b56-4b3a-b5f4-2b48e7a15287"
              }
            },
            "UPD_Receivables": {
              "type": "Query",
              "inputs": {
                "from": "@body('SPL_Receivables_Ary')",
                "where": "@equals(contains(\r\n  body('RSM_Receivables_Ary'),\r\n  removeProperty(\r\n    item(),\r\n    'sharePointListId'\r\n  )\r\n),false)"
              },
              "runAfter": {
                "SPL_Receivables_Ary": [
                  "Succeeded"
                ]
              }
            },
            "Each_Resident": {
              "type": "Foreach",
              "foreach": "@body('FINAL_Receivables')",
              "actions": {
                "Match_Receivables": {
                  "type": "Query",
                  "inputs": {
                    "from": "@body('RSM_Receivables_Ary')",
                    "where": "@equals(item()?['billingAccountId'],items('Each_Resident')?['billingAccountId'])"
                  }
                },
                "Update_Receivables": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "dataset": "@parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')",
                      "table": "@parameters('UPM-DHA SharePoint List (Intake Form) (clr_UPMDHASharePointListIntakeForm)')",
                      "id": "@item()?['sharePointListId']",
                      "item/Charges": "@body('Match_Receivables')?[0]?['Charges']",
                      "item/Payments": "@body('Match_Receivables')?[0]?['Payments']",
                      "item/Credits": "@body('Match_Receivables')?[0]?['Credits']",
                      "item/Balance": "@body('Match_Receivables')?[0]?['Balance']",
                      "item/ReceivablesJSON": "@body('Match_Receivables')?[0]?['Transactions']",
                      "item/BalanceMD": "@null"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                      "operationId": "PatchItem",
                      "connectionName": "shared_sharepointonline"
                    }
                  },
                  "runAfter": {
                    "Match_Receivables": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "runAfter": {
                "FINAL_Receivables": [
                  "Succeeded"
                ]
              }
            },
            "SPL_Receivables_Ary": {
              "type": "Select",
              "inputs": {
                "from": "@outputs('Get_SPL_Residents')?['body/value']",
                "select": {
                  "Charges": "@item()?['Charges']",
                  "Payments": "@item()?['Payments']",
                  "Credits": "@item()?['Credits']",
                  "Balance": "@item()?['Balance']",
                  "Transactions": "@if(\r\n  empty(string(item()?['ReceivablesJSON'])),\r\n  item()?['ReceivablesJSON'],\r\n  json(item()?['ReceivablesJSON'])\r\n)",
                  "billingAccountId": "@item()?['Tenant_x0020_Name_x003a__x0020_b/Value']",
                  "sharePointListId": "@item()?['ID']"
                }
              },
              "runAfter": {
                "Get_SPL_Residents": [
                  "Succeeded"
                ]
              }
            },
            "FINAL_Receivables": {
              "type": "Query",
              "inputs": {
                "from": "@body('UPD_Receivables')",
                "where": "@equals(if(\r\n  and(\r\n    empty(string(item()?['Charges'])),\r\n    empty(string(item()?['Payments'])),\r\n    empty(string(item()?['Credits'])),\r\n    empty(string(item()?['Balance']))\r\n  ),\r\n  contains(\r\n    body('RSM_Receivables_Ids'),\r\n    item()?['billingAccountId']\r\n  ),\r\n  true\r\n),true)"
              },
              "runAfter": {
                "UPD_Receivables": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Get_Receivables": [
              "Succeeded"
            ]
          }
        },
        "Respond_to_flow": {
          "type": "Response",
          "kind": "PowerApp",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {},
              "additionalProperties": {}
            },
            "statusCode": 200
          },
          "runAfter": {
            "Add_Receivables": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}