{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline-1": {
        "api": {
          "name": "shared_sharepointonline"
        },
        "connection": {
          "connectionReferenceLogicalName": "clr_UPMDHASharePointConnection"
        },
        "runtimeSource": "embedded"
      },
      "shared_keyvault": {
        "api": {
          "name": "shared_keyvault"
        },
        "connection": {
          "connectionReferenceLogicalName": "clr_UPMDHAAzureVaultConnection"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)": {
          "defaultValue": "https://upsidecapitalholdings.sharepoint.com/Automation/UPM-DHA/DEV",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointSite"
          }
        },
        "UPM-DHA SharePoint List (Intake Form) (clr_UPMDHASharePointListIntakeForm)": {
          "defaultValue": "26ac3f0d-5a5d-47cd-a6b8-1e99b9d34b87",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointListIntakeForm"
          }
        },
        "UPM-DHA ResMan API (Secret Name) (clr_UPMDHAResManAPISecretName)": {
          "defaultValue": "ResMan-Authorization-PRD",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHAResManAPISecretName"
          }
        },
        "UPM-DHA SharePoint List (GPT Prompts) (clr_UPMDHASharePointListGPTPrompts)": {
          "defaultValue": "add0956c-c84c-4e31-aeb8-5921666e7aaf",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointListGPTPrompts"
          }
        }
      },
      "triggers": {
        "When_an_item_is_created_or_modified": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')",
              "table": "@parameters('UPM-DHA SharePoint List (Intake Form) (clr_UPMDHASharePointListIntakeForm)')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetOnUpdatedItems",
              "connectionName": "shared_sharepointonline-1"
            }
          },
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "conditions": [
            {
              "expression": "@not(triggerBody()?['Processed'])"
            }
          ],
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": {
            "operationMetadataId": "9812c6ee-4be0-4047-ba50-1d64f0962ee5"
          }
        }
      },
      "actions": {
        "Set_Prerequisites": {
          "type": "Scope",
          "actions": {
            "Get_ResMan_Secret": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "secretName": "@parameters('UPM-DHA ResMan API (Secret Name) (clr_UPMDHAResManAPISecretName)')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
                  "operationId": "GetSecret",
                  "connectionName": "shared_keyvault"
                }
              }
            },
            "Get_System_Prompt": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')",
                  "table": "@parameters('UPM-DHA SharePoint List (GPT Prompts) (clr_UPMDHASharePointListGPTPrompts)')",
                  "id": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItem",
                  "connectionName": "shared_sharepointonline-1"
                }
              },
              "runAfter": {
                "Get_ResMan_Secret": [
                  "Succeeded"
                ]
              }
            },
            "LLM_Analysis_URL": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "7d4722cf-b06f-f111-ab0d-7c1e525965e1"
                },
                "body": {
                  "text": "UPM-DHA LLM Analysis Endpoint"
                }
              },
              "runAfter": {
                "Get_System_Prompt": [
                  "Succeeded"
                ]
              }
            },
            "SPL_Connector_URL": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "7d4722cf-b06f-f111-ab0d-7c1e525965e1"
                },
                "body": {
                  "text": "UPM-DHA SharePoint Connector"
                }
              },
              "runAfter": {
                "LLM_Analysis_URL": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {}
        },
        "Process_Resident": {
          "type": "Scope",
          "actions": {
            "Current_DHA_Details": {
              "type": "Compose",
              "inputs": {
                "CaseworkerName": "@triggerBody()?['CaseworkerName']",
                "CaseworkerContact": "@triggerBody()?['CaseworkerContact']",
                "HAPContractStart": "@triggerBody()?['HAPContractStart']",
                "HAPContractEnd": "@triggerBody()?['HAPContractEnd']",
                "MonthlyRent": "@triggerBody()?['MonthlyRent']",
                "HAPPortion": "@triggerBody()?['HAPPortion']",
                "ApplicationFee": "@triggerBody()?['ApplicationFee']",
                "AdministrativeFee": "@triggerBody()?['AdministrativeFee']",
                "RiskFee": "@triggerBody()?['RiskFee']",
                "LandlordIncentiveFee": "@triggerBody()?['LandlordIncentiveFee']",
                "SecurityDeposit": "@triggerBody()?['SecurityDeposit']",
                "HAPContract": "@triggerBody()?['HAPContract']",
                "WelcomeLetter": "@triggerBody()?['WelcomeLetter']",
                "HAPAmendment1Date": "@triggerBody()?['HAPAmendment1Date']",
                "HAPAmendment2Date": "@triggerBody()?['HAPAmendment2Date']",
                "HAPAmendment3Date": "@triggerBody()?['HAPAmendment3Date']",
                "HAPAmendment1Portion": "@triggerBody()?['HAPAmendment1Portion']",
                "HAPAmendment2Portion": "@triggerBody()?['HAPAmendment2Portion']",
                "HAPAmendment3Portion": "@triggerBody()?['HAPAmendment3Portion']"
              }
            },
            "Extract_Doc_Content": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "20acdbdd-3d7c-f111-ab0e-6045bdd75008"
                },
                "body": {
                  "text": "@outputs('Get_System_Prompt')?['body/SystemPrompt']",
                  "text_1": "@string(outputs('Current_DHA_Details'))",
                  "text_2": "@triggerBody()?['Tenant_x0020_Name_x003a__x0020_p1/Value']",
                  "text_3": "@triggerBody()?['Tenant_x0020_Name_x003a__x0020_b/Value']",
                  "text_4": "@triggerBody()?['TenantName/Value']",
                  "number": "@triggerBody()?['ID']",
                  "text_5": "@coalesce(\r\n  triggerBody()?['Tenant_x0020_Name_x003a__x0020_l/Value'],\r\n  ''\r\n)",
                  "text_6": "null",
                  "text_7": "@string(triggerBody()?['Processed'])",
                  "text_8": "@coalesce(\r\n  triggerBody()?['HAPContract'],\r\n  ''\r\n)",
                  "text_9": "@coalesce(\r\n  triggerBody()?['WelcomeLetter'],\r\n  ''\r\n)",
                  "text_10": "@coalesce(\r\n  triggerBody()?['AmendmentNotice'],\r\n  ''\r\n)",
                  "text_11": "@body('LLM_Analysis_URL')?['callback_url']",
                  "text_12": "@body('SPL_Connector_URL')?['callback_url']",
                  "text_13": "@outputs('Get_ResMan_Secret')?['body/value']"
                }
              },
              "runAfter": {
                "Current_DHA_Details": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Set_Prerequisites": [
              "Succeeded"
            ]
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}