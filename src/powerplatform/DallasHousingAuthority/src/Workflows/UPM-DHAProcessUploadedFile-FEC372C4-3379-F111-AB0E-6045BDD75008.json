                              "Monthly Rent": {
                                "type": [
                                  "number",
                                  "null"
                                ]
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "Valid_Document": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "equals": [
