      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "UPM-DHA SharePoint Library (Documents) (clr_UPSDHASharePointLibraryDocuments)": {
          "defaultValue": "25bb2029-7af1-4af0-9efe-beddf5747e9e",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPSDHASharePointLibraryDocuments"
          }
        },
        "UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)": {
          "defaultValue": "https://upsidecapitalholdings.sharepoint.com/Automation/UPM-DHA/DEV",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointSite"
          }
        },
        "UPM-DHA SharePoint List (Intake Form) (clr_UPMDHASharePointListIntakeForm)": {
          "defaultValue": "26ac3f0d-5a5d-47cd-a6b8-1e99b9d34b87",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointListIntakeForm"
          }
        },
        "UPM-DHA SharePoint List (GPT Prompts) (clr_UPMDHASharePointListGPTPrompts)": {
          "defaultValue": "add0956c-c84c-4e31-aeb8-5921666e7aaf",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointListGPTPrompts"
          }
        }
      },
      "triggers": {
        "When_a_file_is_created_(properties_only)": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')",
              "table": "@parameters('UPM-DHA SharePoint Library (Documents) (clr_UPSDHASharePointLibraryDocuments)')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetOnNewFileItems",
              "connectionName": "shared_sharepointonline-1"
            }
          },
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "conditions": [
            {
              "expression": "@equals(triggerBody()?['Status'], 'Queued')"
            }
          ],
          "splitOn": "@triggerOutputs()?['body/value']"
        }
      },
      "actions": {
        "Init_SPL_Payload_Ary": {
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "arySPL_Payload",
                "type": "array"
              }
            ]
          },
          "runAfter": {}
        },
        "Process_Payload": {
          "type": "Scope",
          "actions": {
            "Valid_Payload": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@empty(variables('arySPL_Payload'))",
                      "@false"
                    ]
                  }
                ]
              },
              "actions": {
                "Payload_Array": {
                  "type": "Select",
                  "inputs": {
                    "from": "@variables('arySPL_Payload')",
                    "select": {
                      "@{item()?['Key']}": "@item()?['Value']"
                    }
                  }
                },
                "Payload_Object": {
                  "type": "Compose",
                  "inputs": "@json(\n  substring(\n    replace(\n      string(body('Payload_Array')),\n      '},{',\n      ','\n    ), \n    1, \n    sub(\n      length(\n        replace(\n          string(body('Payload_Array')),\n          '},{',\n          ','\n        )\n      ), \n      2\n    )\n  )\n)",
                  "runAfter": {
                    "Payload_Array": [
                      "Succeeded"
                    ]
                  }
                },
                "Payload_Requests": {
                  "type": "Compose",
                  "inputs": [
                    {
                      "Site Address": "@{parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')}",
                      "Uri": "_api/web/lists(guid'@{parameters('UPM-DHA SharePoint List (Intake Form) (clr_UPMDHASharePointListIntakeForm)')}')",
                      "Method": "GET",
                      "Output": "ListItemEntityTypeFullName"
                    },
                    {
                      "Site Address": "@{parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')}",
                      "Uri": "_api/web/lists(guid'@{parameters('UPM-DHA SharePoint List (Intake Form) (clr_UPMDHASharePointListIntakeForm)')}')/items(@{replace(\n  replace(\n    last(\n      split(\n        triggerBody()?['{Path}'], \n        '(')\n      ),\n    ')',\n    ''\n  ),\n  '/',\n  ''\n)})",
                      "Method": "POST",
                      "Headers": {
                        "Content-Type": "application/json;odata=verbose",
                        "IF-MATCH": "*",
                        "X-HTTP-Method": "MERGE"
                      },
                      "Body": "@addProperty(\n  addProperty(\n    outputs('Payload_Object'),\n    'Processed',\n    true\n  ),\n  '__metadata',\n  json('{\"type\": \"_replace_with_previous_output_\"}')\n)"
                    }
                  ],
                  "runAfter": {
                    "Payload_Object": [
                      "Succeeded"
                    ]
                  }
                },
                "Send_SPL_Requests": {
                  "type": "Http",
                  "inputs": {
                    "uri": "@body('SPL_Connector_URL')?['callback_url']",
                    "method": "POST",
                    "body": "@outputs('Payload_Requests')",
                    "retryPolicy": {
                      "type": "fixed",
                      "count": 2,
                      "interval": "PT20S"
                    }
                  },
                  "runAfter": {
                    "Payload_Requests": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "contentTransfer": {
                      "transferMode": "Chunked"
                    }
                  }
                }
              },
              "else": {
                "actions": {}
              },
              "runAfter": {
                "SPL_Connector_URL": [
                  "Succeeded"
                ]
              }
            },
            "SPL_Connector_URL": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "7d4722cf-b06f-f111-ab0d-7c1e525965e1"
                },
                "body": {
                  "text": "UPM-DHA SharePoint Connector"
                }
              }
            }
          },
          "runAfter": {
            "Process_Doc": [
              "Succeeded"
            ]
          }
        },
        "Process_Doc": {
          "type": "Scope",
          "actions": {
            "Get_file_content": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')",
                  "id": "@triggerBody()?['{Identifier}']",
                  "inferContentType": true
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetFileContent",
                  "connectionName": "shared_sharepointonline-1"
                }
              }
            },
            "Get_System_Prompt": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')",
                  "table": "@parameters('UPM-DHA SharePoint List (GPT Prompts) (clr_UPMDHASharePointListGPTPrompts)')",
                  "id": 1
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItem",
                  "connectionName": "shared_sharepointonline-1"
                }
              },
              "runAfter": {
                "Get_file_content": [
                  "Succeeded"
                ]
              }
            },
            "LLM_Analysis_URL": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "7d4722cf-b06f-f111-ab0d-7c1e525965e1"
                },
                "body": {
                  "text": "UPM-DHA LLM Analysis Endoint"
                }
              },
              "runAfter": {
                "Get_System_Prompt": [
                  "Succeeded"
                ]
              }
            },
            "POST_LLM_Analysis": {
              "type": "Http",
              "inputs": {
                "uri": "@body('LLM_Analysis_URL')?['callback_url']",
                "method": "POST",
                "body": {
                  "System Message": "@outputs('Get_System_Prompt')?['body/SystemPrompt']",
                  "User Message": [
                    "@if(\n  contains(\n    body('Get_file_content')?['$content-type'],\n    'image'\n  ),\n  addProperty(\n    json('{\"type\": \"input_image\"}'),\n    'image_url',\n    concat(\n      'data:', body('Get_file_content')?['$content-type'],\n      ';base64,', base64(body('Get_file_content'))\n    )\n  ),\n  addProperty(\n    addProperty(\n      json('{\"type\": \"input_file\"}'),\n      'file_data',\n      concat(\n        'data:', body('Get_file_content')?['$content-type'],\n        ';base64,', base64(body('Get_file_content'))\n      )\n    ),\n    'filename',\n    triggerBody()?['{Name}']\n  )\n)",
                    {
                      "type": "input_text",
                      "text": "Extract the relevant content from the document."
                    }
                  ],
                  "JSON Format": true
                }
              },
              "runAfter": {
                "LLM_Analysis_URL": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "contentTransfer": {
                  "transferMode": "Chunked"
                }
              }
            },
            "LLM_Response": {
              "type": "If",
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@body('POST_LLM_Analysis')?['Status']",
