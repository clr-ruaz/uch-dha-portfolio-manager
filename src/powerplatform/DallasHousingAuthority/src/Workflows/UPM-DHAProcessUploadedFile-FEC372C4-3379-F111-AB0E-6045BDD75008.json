                        "Coordinator Email": {
                          "type": "string"
                        },
                        "Coordinator Phone": {
                          "type": "string"
                        },
                        "Lease Start Date": {
                          "type": "string"
                        },
                        "Lease End Date": {
                          "type": "string"
                        },
                        "Monthly Rent": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
