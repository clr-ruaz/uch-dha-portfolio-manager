                        "actions": {
                          "HAP_Payload": {
                            "type": "Query",
                            "inputs": {
                              "from": [
                                {
                                  "Key": "CaseworkerName",
                                  "Value": "@if(\n  not(empty(string(body('Document_Details')?['Coordinator Name']))),\n  body('Document_Details')?['Coordinator Name'],\n  'exclude'\n)",
                                  "Type": "Text"
                                },
                                {
                                  "Key": "CaseworkerContact",
                                  "Value": "@if(\n  or(\n    not(empty(string(body('Document_Details')?['Coordinator Email']))),\n    not(empty(string(body('Document_Details')?['Coordinator Phone'])))\n  ),\n  concat(\n    body('Document_Details')?['Coordinator Email'],\n    if(\n      or(\n        empty(body('Document_Details')?['Coordinator Email']),\n        empty(body('Document_Details')?['Coordinator Phone'])\n      ),\n      '',\n      ' / '\n    ),\n    body('Document_Details')?['Coordinator Phone']\n  ),\n  'exclude'\n)",
                                  "Type": "Text"
                                },
                                {
                                  "Key": "HAPContractStart",
                                  "Value": "@if(\n  and(\n    not(empty(body('Document_Details')?['Lease Start Date'])),\n    not(empty(body('Document_Details')?['Lease End Date']))\n  ),\n  body('Document_Details')?['Lease Start Date'],\n  'exclude'\n)",
                                  "Type": "Number"
                                },
                                {
                                  "Key": "HAPContractEnd",
                                  "Value": "@if(\n  not(empty(string(body('Document_Details')?['Lease End Date']))),\n  body('Document_Details')?['Lease End Date'],\n  'exclude'\n)",
                                  "Type": "Number"
                                },
                                {
                                  "Key": "MonthlyRent",
                                  "Value": "@if(\n  not(empty(string(body('Document_Details')?['Monthly Rent']))),\n  body('Document_Details')?['Monthly Rent'],\n  'exclude'\n)",
                                  "Type": "Number"
                                },
                                {
                                  "Key": "HAPPortion",
                                  "Value": "@if(\n  not(empty(string(body('Document_Details')?['HAP Amount']))),\n  body('Document_Details')?['HAP Amount'],\n  'exclude'\n)",
