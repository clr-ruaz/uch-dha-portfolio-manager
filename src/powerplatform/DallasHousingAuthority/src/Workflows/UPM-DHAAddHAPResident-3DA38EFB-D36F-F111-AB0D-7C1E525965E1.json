{
  "properties": {
    "connectionReferences": {
      "shared_sharepointonline-1": {
        "api": {
          "name": "shared_sharepointonline"
        },
        "connection": {
          "connectionReferenceLogicalName": "clr_UPMDHASharePointConnection"
        },
        "runtimeSource": "embedded"
      },
      "shared_keyvault": {
        "api": {
          "name": "shared_keyvault"
        },
        "connection": {
          "connectionReferenceLogicalName": "clr_UPMDHAAzureVaultConnection"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "UPM-DHA SharePoint List (People) (clr_UPMDHASharePointListPeople)": {
          "defaultValue": "a41d99ea-6762-48a2-8391-076f8df64136",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointListPeople"
          }
        },
        "UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)": {
          "defaultValue": "https://upsidecapitalholdings.sharepoint.com/Automation/UPM-DHA/DEV",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointSite"
          }
        },
        "UPM-DHA SharePoint List (Intake Form) (clr_UPMDHASharePointListIntakeForm)": {
          "defaultValue": "26ac3f0d-5a5d-47cd-a6b8-1e99b9d34b87",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointListIntakeForm"
          }
        },
        "UPM-DHA SharePoint Library (Documents) (clr_UPSDHASharePointLibraryDocuments)": {
          "defaultValue": "25bb2029-7af1-4af0-9efe-beddf5747e9e",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPSDHASharePointLibraryDocuments"
          }
        },
        "UPM-DHA ResMan API (Secret Name) (clr_UPMDHAResManAPISecretName)": {
          "defaultValue": "ResMan-Authorization-PRD",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHAResManAPISecretName"
          }
        }
      },
      "triggers": {
        "When_an_item_is_created": {
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "@parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')",
              "table": "@parameters('UPM-DHA SharePoint List (People) (clr_UPMDHASharePointListPeople)')"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
              "operationId": "GetOnNewItems",
              "connectionName": "shared_sharepointonline-1"
            }
          },
          "recurrence": {
            "interval": 1,
            "frequency": "Minute"
          },
          "conditions": [
            {
              "expression": "@or(   contains(     toLower(triggerBody()?['prospectSourceName']),     'dallas housing authority'   ),   startsWith(     toLower(triggerBody()?['prospectSourceName']),     'dha'   ) )"
            },
            {
              "expression": "@contains(   toLower(triggerBody()?['householdStatus']),   'head of household' )"
            }
          ],
          "runtimeConfiguration": {
            "concurrency": {
              "runs": 1
            }
          },
          "splitOn": "@triggerOutputs()?['body/value']",
          "metadata": {
            "operationMetadataId": "567ba097-575d-45d5-860b-8dc35797ca47"
          }
        }
      },
      "actions": {
        "Fetch_Ledger": {
          "type": "Scope",
          "actions": {
            "Get_ResMan_Secret": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "secretName": "@parameters('UPM-DHA ResMan API (Secret Name) (clr_UPMDHAResManAPISecretName)')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
                  "operationId": "GetSecret",
                  "connectionName": "shared_keyvault"
                }
              },
              "runAfter": {
                "Init_Posting_Date": [
                  "Succeeded"
                ]
              }
            },
            "Init_Posting_Date": {
              "type": "Expression",
              "kind": "ConvertTimeZone",
              "inputs": {
                "baseTime": "@addDays(utcNow(), -730)",
                "sourceTimeZone": "UTC",
                "destinationTimeZone": "UTC",
                "formatString": "u"
              }
            },
            "Record_Transactions": {
              "type": "Workflow",
              "inputs": {
                "host": {
                  "workflowReferenceName": "7a6bb697-0b96-f111-8075-3833c5eecd2d"
                },
                "body": {
                  "text": "@triggerBody()?['propertyId']",
                  "text_1": "@triggerBody()?['billingAccountId']",
                  "text_2": "@formatDateTime(\n  body('Init_Posting_Date'),\n  'yyyy-MM-dd'\n)",
                  "text_3": "@outputs('Get_ResMan_Secret')?['body/value']",
                  "number": "@triggerBody()?['ID']"
                }
              },
              "runAfter": {
                "Get_ResMan_Secret": [
                  "Succeeded"
                ]
              }
            }
          },
          "runAfter": {
            "Add_Resident": [
              "Succeeded"
            ]
          }
        },
        "Add_Resident": {
          "type": "Scope",
          "actions": {
            "Create_Intake_Item": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')",
                  "table": "@parameters('UPM-DHA SharePoint List (Intake Form) (clr_UPMDHASharePointListIntakeForm)')",
                  "item/TenantName/Id": "@triggerBody()?['ID']"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "PostItem",
                  "connectionName": "shared_sharepointonline-1"
                }
              }
            },
            "Create_new_folder": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')",
                  "table": "@parameters('UPM-DHA SharePoint Library (Documents) (clr_UPSDHASharePointLibraryDocuments)')",
                  "parameters/path": "@{outputs('Create_Intake_Item')?['body/TenantName/Value']} (@{outputs('Create_Intake_Item')?['body/ID']})"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "CreateNewFolder",
                  "connectionName": "shared_sharepointonline-1"
                }
              },
              "runAfter": {
                "Create_Intake_Item": [
                  "SUCCEEDED"
                ]
              }
            }
          },
          "runAfter": {}
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}