{
  "properties": {
    "connectionReferences": {
      "shared_keyvault": {
        "api": {
          "name": "shared_keyvault"
        },
        "connection": {
          "connectionReferenceLogicalName": "clr_UPMDHAAzureVaultConnection"
        },
        "runtimeSource": "embedded"
      },
      "shared_sharepointonline": {
        "api": {
          "name": "shared_sharepointonline"
        },
        "connection": {
          "connectionReferenceLogicalName": "clr_UPMDHASharePointConnection"
        },
        "runtimeSource": "embedded"
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)": {
          "defaultValue": "https://upsidecapitalholdings.sharepoint.com/Automation/UPM-DHA/DEV",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointSite"
          }
        },
        "UPM-DHA ResMan API (Secret Name) (clr_UPMDHAResManAPISecretName)": {
          "defaultValue": "ResMan-Authorization-PRD",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHAResManAPISecretName"
          }
        },
        "UPM-DHA SharePoint List (Intake Form) (clr_UPMDHASharePointListIntakeForm)": {
          "defaultValue": "26ac3f0d-5a5d-47cd-a6b8-1e99b9d34b87",
          "type": "String",
          "metadata": {
            "schemaName": "clr_UPMDHASharePointListIntakeForm"
          }
        }
      },
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Day",
            "interval": 1,
            "timeZone": "Pacific Standard Time",
            "startTime": "2026-08-04T02:00:00Z"
          },
          "metadata": {
            "operationMetadataId": "18a25f26-2d35-4670-802b-eaee9c680f81"
          }
        }
      },
      "actions": {
        "Fetch_Ledger": {
          "type": "Scope",
          "actions": {
            "Get_ResMan_Secret": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "secretName": "@parameters('UPM-DHA ResMan API (Secret Name) (clr_UPMDHAResManAPISecretName)')"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_keyvault",
                  "operationId": "GetSecret",
                  "connectionName": "shared_keyvault"
                }
              },
              "runAfter": {
                "Previous_Date": [
                  "Succeeded"
                ]
              }
            },
            "Get_DHA_Residents": {
              "type": "OpenApiConnection",
              "inputs": {
                "parameters": {
                  "dataset": "@parameters('UPM-DHA SharePoint Site (clr_UPMDHASharePointSite)')",
                  "table": "@parameters('UPM-DHA SharePoint List (Intake Form) (clr_UPMDHASharePointListIntakeForm)')",
                  "$filter": "TenantName/residencyStatus ne 'Denied' and \nTenantName/residencyStatus ne 'Cancelled' and \nDHAStatus ne 'Expired'"
                },
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
                  "operationId": "GetItems",
                  "connectionName": "shared_sharepointonline"
                }
              },
              "runAfter": {
                "Get_ResMan_Secret": [
                  "Succeeded"
                ]
              },
              "runtimeConfiguration": {
                "paginationPolicy": {
                  "minimumItemCount": 5000
                }
              }
            },
            "Each_Resident": {
              "type": "Foreach",
              "foreach": "@body('Resident_Details')",
              "actions": {
                "Record_Transactions": {
                  "type": "Workflow",
                  "inputs": {
                    "host": {
                      "workflowReferenceName": "7a6bb697-0b96-f111-8075-3833c5eecd2d"
                    },
                    "body": {
                      "text": "@item()?['propertyId']",
                      "text_1": "@item()?['billingAccountId']",
                      "text_2": "@formatDateTime(\n  body('Previous_Date'),\n  'yyyy-MM-dd'\n)",
                      "text_3": "@outputs('Get_ResMan_Secret')?['body/value']",
                      "number": "@items('Each_Resident')?['tenantId']"
                    }
                  }
                }
              },
              "runAfter": {
                "Resident_Details": [
                  "Succeeded"
                ]
              }
            },
            "Resident_Details": {
              "type": "Select",
              "inputs": {
                "from": "@outputs('Get_DHA_Residents')?['body/value']",
                "select": {
                  "propertyId": "@item()?['Tenant_x0020_Name_x003a__x0020_p1/Value']",
                  "billingAccountId": "@item()?['Tenant_x0020_Name_x003a__x0020_b/Value']",
                  "tenantId": "@item()?['TenantName/Id']"
                }
              },
              "runAfter": {
                "Get_DHA_Residents": [
                  "Succeeded"
                ]
              }
            },
            "Previous_Date": {
              "type": "Expression",
              "kind": "ConvertTimeZone",
              "inputs": {
                "baseTime": "@addDays(utcNow(), -1)",
                "sourceTimeZone": "UTC",
                "destinationTimeZone": "UTC",
                "formatString": "u"
              }
            }
          },
          "runAfter": {}
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}